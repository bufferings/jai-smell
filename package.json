{
  "name": "jai-smell",
  "version": "0.5.1",
  "description": "AI が生成した文章に多用される日本語の表現を検出するツール",
  "license": "MIT",
  "repository": "https://github.com/bufferings/jai-smell",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build --compile src/main.ts --asset-naming=\"[name].[ext]\" --outfile dist/jai-smell",
    "check": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "notices": "bun scripts/third-party-notices.ts"
  },
  "dependencies": {
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "@textlint/ast-node-types": "^16.1.1",
    "@textlint/kernel": "^16.1.1",
    "@textlint/markdown-to-ast": "^16.1.1",
    "@textlint/textlint-plugin-markdown": "^16.1.1",
    "@textlint/textlint-plugin-text": "^16.1.1",
    "highlight.js": "11.12.0",
    "kuromojin": "^3.0.2",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
